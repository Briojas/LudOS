#!/bin/bash

# LudOS Steam Management Command
# User-friendly interface for managing Steam Big Picture

set -euo pipefail

SCRIPT_NAME="ludos-steam"
SERVICE_NAME="steam-bigpicture.service"

# Color output
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# Helper functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $*"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $*"
}

# Show usage
show_usage() {
    cat << EOF
LudOS Steam Management - Control Steam Big Picture Mode

USAGE:
    $SCRIPT_NAME <command>

COMMANDS:
    start           Start Steam Big Picture
    stop            Stop Steam
    restart         Restart Steam
    status          Show Steam service status
    enable          Enable Steam to start on boot
    disable         Disable Steam auto-start
    logs            Show Steam logs
    desktop         Launch Steam in desktop mode (not Big Picture)

EXAMPLES:
    $SCRIPT_NAME start              # Start Steam Big Picture
    $SCRIPT_NAME status             # Check if running
    $SCRIPT_NAME logs               # View Steam logs
    $SCRIPT_NAME desktop            # Launch desktop mode manually

NOTES:
    - Steam runs on Gamescope display :0
    - Sunshine streams this display to Moonlight clients
    - Enable steam-bigpicture.service for auto-start
    - Use 'desktop' mode if you need the traditional Steam interface

EOF
}

# Get service status
get_status() {
    systemctl is-active "$SERVICE_NAME" 2>/dev/null || echo "inactive"
}

# Check if service is enabled
is_enabled() {
    systemctl is-enabled "$SERVICE_NAME" 2>/dev/null || echo "disabled"
}

# Command: status
cmd_status() {
    local status=$(get_status)
    local enabled=$(is_enabled)
    
    echo "=== Steam Big Picture Status ==="
    echo ""
    
    if [ "$status" = "active" ]; then
        print_success "Steam is running"
    else
        print_warning "Steam is not running"
    fi
    
    echo "Status: $status"
    echo "Enabled: $enabled"
    echo ""
    
    # Show detailed systemd status
    systemctl status "$SERVICE_NAME" --no-pager -l || true
    
    echo ""
    
    # Check for Steam process
    if pgrep -u ludos steam >/dev/null; then
        print_success "Steam process detected"
        echo "Steam PIDs: $(pgrep -u ludos steam | tr '\n' ' ')"
    else
        print_warning "No Steam process found"
    fi
}

# Command: start
cmd_start() {
    print_info "Starting Steam Big Picture..."
    
    if sudo systemctl start "$SERVICE_NAME"; then
        sleep 3
        local status=$(get_status)
        if [ "$status" = "active" ]; then
            print_success "Steam started successfully"
            echo ""
            print_info "Steam is running in Big Picture mode on display :0"
            print_info "Connect via Moonlight to stream"
        else
            print_error "Service started but not active"
            print_info "Check logs with: $SCRIPT_NAME logs"
            return 1
        fi
    else
        print_error "Failed to start Steam"
        return 1
    fi
}

# Command: stop
cmd_stop() {
    print_info "Stopping Steam..."
    
    if sudo systemctl stop "$SERVICE_NAME"; then
        print_success "Steam stopped"
    else
        print_error "Failed to stop Steam"
        return 1
    fi
}

# Command: restart
cmd_restart() {
    print_info "Restarting Steam..."
    
    if sudo systemctl restart "$SERVICE_NAME"; then
        sleep 3
        local status=$(get_status)
        if [ "$status" = "active" ]; then
            print_success "Steam restarted successfully"
        else
            print_error "Service restarted but not active"
            return 1
        fi
    else
        print_error "Failed to restart Steam"
        return 1
    fi
}

# Command: enable
cmd_enable() {
    print_info "Enabling Steam auto-start..."
    
    if sudo systemctl enable "$SERVICE_NAME"; then
        print_success "Steam will start on boot"
    else
        print_error "Failed to enable Steam service"
        return 1
    fi
}

# Command: disable
cmd_disable() {
    print_info "Disabling Steam auto-start..."
    
    if sudo systemctl disable "$SERVICE_NAME"; then
        print_success "Steam will not start on boot"
    else
        print_error "Failed to disable Steam service"
        return 1
    fi
}

# Command: logs
cmd_logs() {
    print_info "Showing Steam logs..."
    echo ""
    journalctl -u "$SERVICE_NAME" -n 50 --no-pager
    
    echo ""
    print_info "For live logs, use: journalctl -u $SERVICE_NAME -f"
}

# Command: desktop (launch desktop mode manually)
cmd_desktop() {
    print_info "Launching Steam in desktop mode..."
    print_warning "This will launch Steam manually on display :0"
    print_info "The systemd service will NOT manage this instance"
    
    # Check if Gamescope display is available
    if ! DISPLAY=:0 xdpyinfo >/dev/null 2>&1; then
        print_error "Display :0 is not available"
        print_info "Start Gamescope first: ludos-display start"
        return 1
    fi
    
    # Launch Steam in desktop mode as ludos user
    sudo -u ludos env DISPLAY=:0 \
        HOME=/var/home/ludos \
        XDG_RUNTIME_DIR=/run/user/1000 \
        __GLX_VENDOR_LIBRARY_NAME=nvidia \
        __NV_PRIME_RENDER_OFFLOAD=1 \
        steam &
    
    print_success "Steam launched in desktop mode"
    echo "Check Moonlight stream to see Steam interface"
}

# Main command dispatcher
main() {
    if [ $# -eq 0 ]; then
        show_usage
        exit 0
    fi
    
    local command="$1"
    shift
    
    case "$command" in
        start)
            cmd_start
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        enable)
            cmd_enable
            ;;
        disable)
            cmd_disable
            ;;
        logs)
            cmd_logs
            ;;
        desktop)
            cmd_desktop
            ;;
        help|--help|-h)
            show_usage
            ;;
        *)
            print_error "Unknown command: $command"
            echo ""
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
